generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum SystemRole {
  USER
  SUPER_ADMIN
}
model User {
  id                   Int               @id @default(autoincrement())
  firstName            String            @map("first_name") @db.VarChar(100)
  lastName             String            @map("last_name") @db.VarChar(100)
  email                String            @unique @db.VarChar(255)
  password             String            @map("password_hash")
  phone                String?           @db.VarChar(20)
  avatarUrl            String?           @map("avatar_url")

  status               UserStatus        @default(ACTIVE)
  systemRole SystemRole  @default(USER)

  lastLoginAt          DateTime?         @map("last_login_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?         @map("deleted_at") @db.Timestamptz(6)

  invitationsSent      Invitation[]      @relation("InvitationSender")

  workspaceMemberships WorkspaceMember[]
  boardMemberships     BoardMember[]

  createdWorkspaces    Workspace[]       @relation("WorkspaceCreator")
  createdBoards        Board[]            @relation("BoardCreator")
  createdGroups        Group[]            @relation("GroupCreator")
  createdTasks        Task[]            @relation("TaskCreator")

  

  filesUploaded       File[]            @relation("FileUploader")
  taskComments TaskComment[] @relation("TaskCommentAuthor")

  @@map("users")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@map("sessions")
}

model Invitation {
  id          Int                 @id @default(autoincrement())

  email       String
  token       String              @unique

  workspaceId Int
  role WorkspaceMemberRole

  status      InvitationStatus    @default(PENDING)

  invitedById Int

  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime            @default(now())

  workspace   Workspace           @relation(fields: [workspaceId], references: [id])
  invitedBy   User                @relation("InvitationSender", fields: [invitedById], references: [id])

  boards      InvitationBoard[]
  boardIds    Int[]

  @@map("invitations")
}

model InvitationBoard {
  id           Int @id @default(autoincrement())

  invitationId Int
  boardId      Int

  invitation Invitation @relation(fields: [invitationId], references: [id])
  board      Board      @relation(fields: [boardId], references: [id])

  @@unique([invitationId, boardId])
  @@map("invitation_boards")
}
enum WorkspaceMemberRole {
  OWNER
  ADMIN
  MEMBER
}
model WorkspaceMember {
  id          Int                 @id @default(autoincrement())
  workspaceId Int
  userId      Int
  role        WorkspaceMemberRole
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id])
  workspace   Workspace           @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId,userId])
  @@map("workspace_members")

}
enum BoardMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}
model BoardMember {
  id      Int @id @default(autoincrement())
  boardId Int
  userId  Int
  role    BoardMemberRole
  board Board @relation(fields: [boardId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  createdAt   DateTime            @default(now())

  @@unique([boardId, userId])
  @@map("board_members")
}
enum BoardVisibility {
    PUBLIC
    PRIVATE
}

enum WorkspaceVisibility {
    PUBLIC
    PRIVATE
}
model Board {
  id               Int               @id @default(autoincrement())
  name             String
  workspaceId      Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workspace        Workspace         @relation(fields: [workspaceId], references: [id])
  invitationBoards InvitationBoard[]
  visibility       BoardVisibility   @default(PUBLIC)
  members          BoardMember[]

  updatedById      Int?

  createdById      Int
  createdBy        User @relation("BoardCreator", fields:[createdById], references:[id])

  groups            Group[]
  columns           BoardColumn[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("boards")
}

model Workspace {
  id          Int      @id @default(autoincrement())

  name        String
  description String?
  visibility  WorkspaceVisibility @default(PRIVATE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById Int
  createdBy   User      @relation("WorkspaceCreator", fields: [createdById], references: [id])

  boards      Board[]
  members     WorkspaceMember[]
  invitations Invitation[]

  @@unique([createdById, name])
  @@map("workspaces")
}

model Group {
  id          Int      @id @default(autoincrement())

  name        String
  color       String?
  order       Float @default(1000)

  boardId     Int

  createdAt   DateTime @default(now())
  updatedById Int?
  updatedAt   DateTime @updatedAt
  createdById Int
  createdBy    User  @relation("GroupCreator",fields: [createdById], references: [id])

  board        Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([boardId])
  @@index([boardId, order])
   @@unique([boardId, name])
  @@map("groups")

}

model TaskComment {
  id        Int      @id @default(autoincrement())

  taskId    Int
  userId    Int

  content   String

  // null = top-level comment
  // non-null = reply
  parentId  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  parent    TaskComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   TaskComment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([parentId])
}





enum BoardColumnType {
  TEXT
  NUMBER
  DATE
  STATUS
  PERSON
  CHECKBOX
  DROPDOWN
  LABEL
}

model BoardColumn {
  id          Int      @id @default(autoincrement())

  name        String
  type        BoardColumnType

  order       Float

  width       Int      @default(180)

  settings    Json?

  boardId     Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cells      TaskCell[]

  isPrimary Boolean @default(false)

  @@index([boardId])
  @@unique([boardId, name])
  @@map("board_columns")

}
model Task {
  id          Int      @id @default(autoincrement())
  groupId     Int
  order        Float
  name String

  createdById Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group        Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy    User  @relation("TaskCreator", fields: [createdById], references: [id])

  cells        TaskCell[]


  parentId    Int?

  parent       Task?   @relation("TaskHierarchy", fields: [parentId], references: [id])
  subtasks     Task[]  @relation("TaskHierarchy")



  @@index([groupId])
  @@index([groupId, order])

  @@map("tasks")
}
model TaskCell {
  id        Int @id @default(autoincrement())

  taskId    Int
  columnId  Int

  value     Json?

  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  column     BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  files      TaskCellFile[]

  @@unique([taskId, columnId])

  @@index([taskId])
  @@index([columnId])
  @@map("task_cells")

}
model TaskCellFile {
  id        Int      @id @default(autoincrement())

  cellId    Int
  fileId    Int

  createdAt DateTime @default(now())

  cell TaskCell @relation(fields: [cellId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([cellId, fileId])

  @@index([cellId])
  @@index([fileId])
  @@map("task_cell_files")

}
model File {
  id           Int      @id @default(autoincrement())

  originalName String
  storedName   String
  mimeType     String
  size         Int
  url          String

  uploadedById Int
  uploadedAt   DateTime @default(now())

  uploadedBy User @relation("FileUploader", fields: [uploadedById], references: [id])

  cells TaskCellFile[]
  @@map("files")

}

model TaskComment {
  id        Int      @id @default(autoincrement())

  taskId    Int
  userId    Int

  content   String   @db.Text

  // null = top-level comment
  // non-null = reply to a top-level comment
  parentId  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Task
  task Task @relation(
    fields: [taskId],
    references: [id],
    onDelete: Cascade
  )

  // Author
  user User @relation(
    "TaskCommentAuthor",
    fields: [userId],
    references: [id]
  )

  // One-level comment/reply hierarchy
  parent TaskComment? @relation(
    "CommentReplies",
    fields: [parentId],
    references: [id],
    onDelete: Cascade
  )

  replies TaskComment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([taskId, createdAt])
  @@index([parentId])
  @@index([userId])

  @@map("task_comments")
}


enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
}



enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}
