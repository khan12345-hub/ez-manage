generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum SystemRole {
  USER
  SUPER_ADMIN
}
model User {
  id                   Int               @id @default(autoincrement())
  firstName            String            @map("first_name") @db.VarChar(100)
  lastName             String            @map("last_name") @db.VarChar(100)
  email                String            @unique @db.VarChar(255)
  password             String            @map("password_hash")
  phone                String?           @db.VarChar(20)
  avatarUrl            String?           @map("avatar_url")

  status               UserStatus        @default(ACTIVE)
  systemRole SystemRole  @default(USER)

  lastLoginAt          DateTime?         @map("last_login_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?         @map("deleted_at") @db.Timestamptz(6)

  invitationsSent      Invitation[]      @relation("InvitationSender")

  workspaceMemberships WorkspaceMember[]
  boardMemberships     BoardMember[]

  createdWorkspaces    Workspace[]       @relation("WorkspaceCreator")
  createdBoards        Board[]            @relation("BoardCreator")
  createdGroups        Group[]            @relation("GroupCreator")
  createdTasks        Task[]            @relation("TaskCreator")

  commentsAuthored TaskComment[] @relation("TaskCommentAuthor")
  commentMentions  TaskCommentMention[] @relation("TaskCommentMentionUser")

  filesUploaded       File[]            @relation("FileUploader")
  
  notifications        Notification[]

  activityLogs         ActivityLog[]      @relation("ActivityActor")
  undoneActivities     ActivityLog[]      @relation("ActivityUndoneBy")

  boardColumnPermissions BoardColumnPermission[]

  @@map("users")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@map("sessions")
}

model Invitation {
  id          Int                 @id @default(autoincrement())

  email       String
  token       String              @unique

  workspaceId Int
  role WorkspaceMemberRole

  status      InvitationStatus    @default(PENDING)

  invitedById Int

  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime            @default(now())

  workspace   Workspace           @relation(fields: [workspaceId], references: [id])
  invitedBy   User                @relation("InvitationSender", fields: [invitedById], references: [id])

  boards      InvitationBoard[]
  boardIds    Int[]

  @@map("invitations")
}

model InvitationBoard {
  id           Int @id @default(autoincrement())

  invitationId Int
  boardId      Int

  invitation Invitation @relation(fields: [invitationId], references: [id])
  board      Board      @relation(fields: [boardId], references: [id])

  @@unique([invitationId, boardId])
  @@map("invitation_boards")
}
enum WorkspaceMemberRole {
  OWNER
  ADMIN
  MEMBER
}
model WorkspaceMember {
  id          Int                 @id @default(autoincrement())
  workspaceId Int
  userId      Int
  role        WorkspaceMemberRole
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id])
  workspace   Workspace           @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId,userId])
  @@map("workspace_members")

}
enum BoardMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}
model BoardMember {
  id      Int @id @default(autoincrement())
  boardId Int
  userId  Int
  role    BoardMemberRole
  board Board @relation(fields: [boardId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  createdAt   DateTime            @default(now())

  @@unique([boardId, userId])
  @@map("board_members")
}
enum BoardVisibility {
    PUBLIC
    PRIVATE
}

enum WorkspaceVisibility {
    PUBLIC
    PRIVATE
}
model Board {
  id               Int               @id @default(autoincrement())
  name             String
  workspaceId      Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workspace        Workspace         @relation(fields: [workspaceId], references: [id])
  invitationBoards InvitationBoard[]
  visibility       BoardVisibility   @default(PUBLIC)
  members          BoardMember[]

  updatedById      Int?

  createdById      Int
  createdBy        User @relation("BoardCreator", fields:[createdById], references:[id])

  groups            Group[]
  columns           BoardColumn[]

  activities       ActivityLog[]

  form        BoardForm?

  templateId Int?
  template   BoardTemplate? @relation(fields: [templateId], references: [id])

  automations AutomationRule[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("boards")
}

model Workspace {
  id          Int      @id @default(autoincrement())

  name        String
  description String?
  visibility  WorkspaceVisibility @default(PRIVATE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById Int
  createdBy   User      @relation("WorkspaceCreator", fields: [createdById], references: [id])

  boards      Board[]
  members     WorkspaceMember[]
  invitations Invitation[]

  @@unique([createdById, name])
  @@map("workspaces")
}

model Group {
  id          Int      @id @default(autoincrement())

  name        String
  color       String?
  order       Float @default(1000)

  boardId     Int

  createdAt   DateTime @default(now())
  updatedById Int?
  updatedAt   DateTime @updatedAt
  createdById Int
  createdBy    User  @relation("GroupCreator",fields: [createdById], references: [id])

  board        Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks        Task[]

  activities  ActivityLog[]

  automationTargets AutomationRule[] @relation("AutomationTargetGroup")

  @@index([boardId])
  @@index([boardId, order])
  @@map("groups")

}


enum BoardColumnType {
  TEXT
  NUMBER
  DATE
  STATUS
  PERSON
  CHECKBOX
  DROPDOWN
  LABEL
  TIMELINE
  FILE
}
model StatusOption {
  id          Int         @id @default(autoincrement())
  columnId    Int
  label       String
  color       String
  order       Float       @default(1000)
  isArchived  Boolean     @default(false)

  column      BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  automationTriggers AutomationRule[] @relation("AutomationTriggerStatus")

  @@index([columnId])
  @@index([columnId, order])
}

model BoardColumn {
  id          Int      @id @default(autoincrement())

  name        String
  type        BoardColumnType

  order       Float

  width       Int      @default(180)

  statusOptions StatusOption[]

  boardId     Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cells      TaskCell[]

  isPrimary Boolean @default(false)

  boardFormFields BoardFormField[]

  permissions BoardColumnPermission[]

  automationTriggers AutomationRule[] @relation("AutomationTriggerColumn")

  accessControlEnabled Boolean         @default(false)

  @@index([boardId])
  @@map("board_columns")

}
model Task {
  id          Int      @id @default(autoincrement())
  groupId     Int
  order       Float
  name        String

  createdById Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User  @relation("TaskCreator", fields: [createdById], references: [id])

  cells       TaskCell[]

  // Task hierarchy
  parentId    Int?
  parent      Task?  @relation("TaskHierarchy", fields: [parentId], references: [id])
  subtasks    Task[] @relation("TaskHierarchy")

  // Task comments
  comments    TaskComment[]

  activities  ActivityLog[]

  @@index([groupId])
  @@index([groupId, order])

  @@map("tasks")
}
model TaskCell {
  id        Int @id @default(autoincrement())

  taskId    Int
  columnId  Int

  value     Json?

  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  column     BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  files      TaskCellFile[]

  @@unique([taskId, columnId])

  @@index([taskId])
  @@index([columnId])
  @@map("task_cells")

}

model File {
  id         Int      @id @default(autoincrement())

  fileName   String
  storageKey String
  mimeType   String
  fileSize   Int
  url        String

  uploadedById Int
  uploadedAt   DateTime @default(now())

  uploadedBy User @relation("FileUploader", fields: [uploadedById], references: [id])

  cells    TaskCellFile[]
  comments TaskCommentFile[]

  @@index([uploadedById])
  @@map("files")
}

model TaskComment {
  id        Int      @id @default(autoincrement())

  taskId    Int
  userId    Int

  content   String   @db.Text

  // null = top-level comment
  // non-null = reply to a top-level comment
  parentId  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Task
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Author
  user User @relation("TaskCommentAuthor", fields: [userId], references: [id])

  // One-level comment/reply hierarchy
  parent  TaskComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies TaskComment[] @relation("CommentReplies")

  // Mentions
  mentions TaskCommentMention[]

  // Attached files
  files TaskCommentFile[]

  @@index([taskId])
  @@index([taskId, createdAt])
  @@index([parentId])
  @@index([userId])

  @@map("task_comments")
}

model TaskCommentFile {
  id        Int      @id @default(autoincrement())
  commentId Int      @map("comment_id")
  fileId    Int      @map("file_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Comment
  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // File
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([commentId, fileId])
  @@index([commentId])
  @@index([fileId])

  @@map("task_comment_files")
}

model TaskCellFile {
  id     Int @id @default(autoincrement())
  cellId Int @map("cell_id")
  fileId Int @map("file_id")

  createdAt DateTime @default(now())
  cell TaskCell @relation(fields: [cellId], references: [id], onDelete: Cascade)

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([cellId, fileId])
  @@index([cellId])
  @@index([fileId])

  @@map("task_cell_files")
}

model TaskCommentMention {
  id        Int @id @default(autoincrement())

  commentId Int
  userId    Int

createdAt DateTime @default(now())
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation("TaskCommentMentionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("task_comment_mentions")

}
enum ActivityEntityType {
  BOARD
  GROUP
  TASK
  COLUMN
  TASK_CELL
  FILE
  COMMENT
  REPLY
  MEMBER
}
enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
  MOVED
  REORDERED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  FILE_ADDED
  FILE_DELETED
  COMMENT_ADDED
  COMMENT_UPDATED
  COMMENT_DELETED
  REPLY_ADDED
  MEMBER_ADDED
  MEMBER_REMOVED
}
model ActivityLog {
  id          Int                @id @default(autoincrement())

  boardId     Int               @map("board_id")
  taskId      Int?              @map("task_id")
  groupId     Int?              @map("group_id")
  userId      Int               @map("user_id")

  entityType  ActivityEntityType @map("entity_type")
  entityId    Int                @map("entity_id")
  action      ActivityAction

  metadata    Json?

  undoneAt    DateTime?          @map("undone_at")
  undoneById  Int?               @map("undone_by_id")

  createdAt   DateTime           @default(now()) @map("created_at")

  board       Board              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  task        Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  group       Group?             @relation(fields: [groupId], references: [id], onDelete: Cascade)

  user        User               @relation("ActivityActor", fields: [userId], references: [id])
  undoneBy    User?              @relation("ActivityUndoneBy", fields: [undoneById], references: [id])

  @@index([boardId, createdAt])
  @@index([taskId, createdAt])
  @@index([groupId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])

  @@map("activity_logs")
}
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
}
enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}
enum NotificationType {
  TASK_ASSIGNED
  COMMENT_MENTION
  COMMENT_REPLY

  BOARD_MEMBER_ADDED
  WORKSPACE_MEMBER_ADDED

  TASK_STATUS_CHANGED
  TASK_DUE_SOON

  LEAVE_REQUEST_CREATED
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
}

enum NotificationEntityType {
  TASK
  COMMENT
  BOARD
  WORKSPACE
  LEAVE_REQUEST
}



model Notification {
  id String @id @default(cuid())

  recipientId Int

  type NotificationType

  title   String
  message String

  entityType NotificationEntityType?
  entityId   Int?

  metadata Json?

  isRead Boolean @default(false)
  readAt DateTime?

  eventKey String? @unique

  createdAt DateTime @default(now())

  recipient User @relation(fields: [recipientId],references: [id],onDelete: Cascade)

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@index([entityType, entityId])
}

model BoardForm {
  id          Int      @id @default(autoincrement())
  boardId     Int      @unique
  groupId     Int      @unique

  title       String?
  description String?
  submitLabel String?  @default("Submit")
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board  Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  fields BoardFormField[]

  @@index([boardId])
}

model BoardFormField {
  id       Int   @id @default(autoincrement())
  formId   Int
  columnId Int
  position Float @default(0)

  label       String?
  description String?

  required Boolean @default(false)
  hidden   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form   BoardForm   @relation(fields: [formId], references: [id], onDelete: Cascade)
  column BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@unique([formId, columnId])
  @@index([formId])
  @@index([columnId])
}

model BoardTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  boards      Board[] 
  groups BoardTemplateGroup[]

  
}

model BoardTemplateGroup {
  id         Int      @id @default(autoincrement())
  templateId Int
  name       String
  color      String
  position   Int

  template BoardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  columns BoardTemplateColumn[]

  @@index([templateId])
}

model BoardTemplateColumn {
  id        Int      @id @default(autoincrement())
  groupId   Int
  name      String
  type      BoardColumnType
  position  Int
  isPrimary Boolean  @default(false)
  options   Json?

  group BoardTemplateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model BoardColumnPermission {
  id        Int @id @default(autoincrement())
  columnId  Int
  userId    Int
  canEdit   Boolean @default(true)

  column    BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([columnId, userId])
  @@index([userId])
}
enum AutomationTriggerType {
  STATUS_CHANGED
}

enum AutomationActionType {
  MOVE_TO_GROUP
}

model AutomationRule {
  id        Int      @id @default(autoincrement())

  name      String
  isActive  Boolean  @default(true)

  boardId   Int
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  triggerType AutomationTriggerType
  actionType  AutomationActionType

  // STATUS_CHANGED trigger
  triggerColumnId Int?
  triggerColumn   BoardColumn? @relation("AutomationTriggerColumn",fields: [triggerColumnId],references: [id],onDelete: Cascade)

  triggerStatusId Int?
  triggerStatus   StatusOption? @relation("AutomationTriggerStatus", fields: [triggerStatusId], references: [id], onDelete: Cascade)

  // MOVE_TO_GROUP action
  targetGroupId Int?
  targetGroup   Group? @relation("AutomationTargetGroup",fields: [targetGroupId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
  @@index([triggerColumnId])
  @@index([triggerStatusId])
  @@index([targetGroupId])
}