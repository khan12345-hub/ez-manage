{
  "name": "tracker-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "EZ Tracker desktop app: time, screenshots and activity for EZ Manage (Windows first)",
  "main": "dist/main.js",
  "author": "EZ Manage",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "start": "pnpm run build && node scripts/run.mjs",
    "dist:win": "pnpm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.ezmanage.tracker",
    "productName": "EZ Tracker",
    "files": [
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "EZTrackerSetup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "33",
    "electron-builder": "25",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "get-windows": "9",
    "uiohook-napi": "1"
  }
}
